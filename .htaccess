DirectoryIndex index.php

# Bloquear acceso directo a archivos de configuración sensibles
# worker.php NO está aquí — necesita ser accesible via curl interno (tiene su propio token de auth)
<FilesMatch "^(config\.php|config_override\.php|generation_log\.php|job_queue\.php)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Bloquear acceso directo al log de generaciones
<FilesMatch "^generation_log\.json$">
    Order allow,deny
    Deny from all
</FilesMatch>
